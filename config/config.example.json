  "life": {
    "slots": [
      "07:30-08:30",
      "12:00-13:30",
      "18:00-19:30",
      "21:00-23:30"
    ],
    "slotMinGapMinutes": 6,
    "slotMaxGapMinutes": 20,
    "idleMinGapMinutes": 50,
    "idleMaxGapMinutes": 110,
    "quietHours": [
      1,
      7
    ],
    "dailyCap": 10,
    "userActiveWindowMin": 12
  },
  "stickerIndex": ""
}
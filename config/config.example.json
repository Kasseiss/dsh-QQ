{
  "_comment": "这是参考样例；install.sh 会按你的 QQ 号和机器路径生成真正的 bridge/config.json，不用手抄。",
  "onebotHttp": "http://127.0.0.1:39000",
  "onebotWs": "ws://127.0.0.1:39001",
  "token": "换成你的 OneBot token，和 NapCat 里的一致",
  "dshHome": "/opt/whale-bot/home",
  "dshBin": "/opt/whale-bot/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js",
  "dshProfile": "headless",
  "workDir": "/opt/whale-bot/home/work",
  "stickersDir": "/opt/whale-bot/stickers",
  "stickerMaxPerReply": 1,
  "dangerFullAccess": true,
  "allowUsers": [
    123456789
  ],
  "guestUsers": [],
  "guestPermissionMode": "read-only",
  "allowGroups": [],
  "groupAtOnly": true,
  "friendRequestPolicy": "owner-approve",
  "pairing": true,
  "maxConcurrent": 2,
  "queueLimit": 20,
  "queueTimeoutMs": 120000,
  "runTimeoutMs": 600000,
  "progressAfterMs": 45000,
  "chunkSize": 900,
  "chunkGapMs": 900,
  "minGapPerChatMs": 1500,
  "globalPerMinute": 20,
  "humanize": {
    "enabled": true,
    "debounceMs": 7000,
    "minDelayMs": 1600,
    "perCharMs": 26,
    "maxDelayMs": 16000,
    "jitterMs": 900,
    "typing": true,
    "skipToken": "[[跳过]]"
